<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ShepherdSentryDSN</key>
	<string>$(SHEPHERD_SENTRY_DSN)</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_shepherd._tcp</string>
		<string>_ssh._tcp</string>
		<string>_companion-link._tcp</string>
		<string>_device-info._tcp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.bailycase.shepherd.ios.pairing</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>shepherd</string>
				<string>shepherd-nightly</string>
				<string>shepherd-dev</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Scan the code a Shepherd Mac shows to pair this device with it.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
