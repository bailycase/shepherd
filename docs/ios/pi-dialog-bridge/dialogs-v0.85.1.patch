+import { type Container, setKeybindings, Text, type TUI } from "@earendil-works/pi-tui";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal.ts";
+import type { AgentSessionRuntime } from "../src/core/agent-session-runtime.ts";
+import type {
+	DialogAnswer,
+	DialogEvent,
+	ExtensionUIContext,
+	ProjectTrustContext,
+} from "../src/core/extensions/types.ts";
+import { KeybindingsManager } from "../src/core/keybindings.ts";
+import type { ExternalEditorResult } from "../src/modes/interactive/external-editor.ts";
+import { createInteractiveTui, InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+import { initTheme } from "../src/modes/interactive/theme/theme.ts";
+import { createHarness, type Harness } from "./suite/harness.ts";
+
+const externalEditor = vi.hoisted(() => vi.fn<() => Promise<ExternalEditorResult>>());
+vi.mock("../src/modes/interactive/external-editor.ts", () => ({ editInExternalEditor: externalEditor }));
+
+type DialogHost = {
+	ui: TUI;
+	renderer: TUI;
+	editorContainer: Container;
+	createExtensionUIContext(): ExtensionUIContext;
+	createProjectTrustContext(cwd: string): ProjectTrustContext;
+	resetExtensionUI(): void;
+};
+
+const cases = [
+	{ kind: "select", open: (ui: ExtensionUIContext) => ui.select("Pick", ["A", "B"]), value: "B", local: "A" },
+	{ kind: "confirm", open: (ui: ExtensionUIContext) => ui.confirm("Proceed", "Continue?"), value: false, local: true },
+	{ kind: "input", open: (ui: ExtensionUIContext) => ui.input("Name", "placeholder"), value: "", local: "" },
+	{
+		kind: "editor",
+		open: (ui: ExtensionUIContext) => ui.editor("Edit", "prefill"),
+		value: "one\ntwo",
+		local: "prefill",
+	},
+] as const;
+
+let harness: Harness;
+let mode: InteractiveMode;
+let host: DialogHost;
+let terminal: VirtualTerminal;
+let ui: ExtensionUIContext;
+let events: DialogEvent[];
+let lifecycle: string[];
+
+beforeEach(async () => {
+	initTheme("dark", false);
+	lifecycle = [];
+	harness = await createHarness({
+		extensionFactories: [
+			(pi) => {
+				pi.on("ui_prompt_start", () => {
+					lifecycle.push("start");
+				});
+				pi.on("ui_prompt_end", () => {
+					lifecycle.push("end");
+				});
+			},
+		],
+	});
+	mode = new InteractiveMode({
+		session: harness.session,
+		setBeforeSessionInvalidate: () => {},
+		setRebindSession: () => {},
+	} as unknown as AgentSessionRuntime);
+	host = mode as unknown as DialogHost;
+	terminal = new VirtualTerminal();
+	host.ui = host.renderer = createInteractiveTui({
+		tuiMode: "regular",
+		terminal,
+		logDirectory: harness.tempDir,
+		showHardwareCursor: false,
+	});
+	host.ui.addChild(host.editorContainer);
+	setKeybindings(new KeybindingsManager());
+	host.ui.start();
+	await harness.session.bindExtensions({ uiContext: host.createExtensionUIContext(), mode: "tui" });
+	ui = harness.session.extensionRunner.createContext().ui;
+	events = [];
+	ui.onDialog((event) => {
+		events.push(event);
+	});
+});
+
+afterEach(() => {
+	vi.useRealTimers();
+	mode.stop();
+	harness.cleanup();
+});
+
+describe("standard extension dialog bridge", () => {
+	for (const testCase of cases) {
+		it(`${testCase.kind}: publishes mounted native UI, validates remote answers, and settles remote first`, async () => {
+			const result = testCase.open(ui);
+			const [dialog] = ui.getPendingDialogs();
+			expect(dialog.kind).toBe(testCase.kind);
+			expect(host.editorContainer.render(80).join("\n")).toContain(dialog.title);
+			await Promise.resolve();
+			expect(events).toEqual([{ type: "opened", dialog }]);
+			expect(ui.resolveDialog(dialog.id, { kind: "unknown", value: "bad" } as unknown as DialogAnswer)).toBe(
+				"invalid",
+			);
+			expect(ui.resolveDialog(dialog.id, { kind: testCase.kind, value: 42 } as unknown as DialogAnswer)).toBe(
+				"invalid",
+			);
+			expect(ui.resolveDialog(dialog.id, null as unknown as DialogAnswer)).toBe("invalid");
+			if (dialog.kind === "select") {
+				expect(dialog.options).toEqual(["A", "B"]);
+				expect(ui.resolveDialog(dialog.id, { kind: "select", value: "C" })).toBe("invalid");
+			}
+			if (dialog.kind === "confirm") expect(dialog.message).toBe("Continue?");
+			if (dialog.kind === "input") expect(dialog.placeholder).toBe("placeholder");
+			if (dialog.kind === "editor") expect(dialog.prefill).toBe("prefill");
+			expect(ui.resolveDialog(dialog.id, { kind: testCase.kind, value: testCase.value } as DialogAnswer)).toBe(
+				"accepted",
+			);
+			terminal.sendInput("\r");
+			expect(ui.resolveDialog(dialog.id, { kind: "cancel" })).toBe("stale");
+			await expect(result).resolves.toBe(testCase.value);
+			expect(ui.getPendingDialogs()).toEqual([]);
+			expect(events).toEqual([
+				{ type: "opened", dialog },
+				{ type: "closed", id: dialog.id },
+			]);
+			expect(lifecycle).toEqual(["start", "end"]);
+		});
+
+		it(`${testCase.kind}: desktop submission wins synchronously over a remote answer`, async () => {
+			const result = testCase.open(ui);
+			const [dialog] = ui.getPendingDialogs();
+			terminal.sendInput("\r");
+			expect(ui.resolveDialog(dialog.id, { kind: "cancel" })).toBe("stale");
+			await expect(result).resolves.toBe(testCase.local);
+		});
+
+		it(`${testCase.kind}: local and remote cancellation close once`, async () => {
+			for (const remote of [false, true]) {
+				const result = testCase.open(ui);
+				const [dialog] = ui.getPendingDialogs();
+				if (remote) expect(ui.resolveDialog(dialog.id, { kind: "cancel" })).toBe("accepted");
+				else terminal.sendInput("\x1b");
+				await expect(result).resolves.toBe(testCase.kind === "confirm" ? false : undefined);
+				expect(ui.resolveDialog(dialog.id, { kind: "cancel" })).toBe("stale");
+				expect(events.filter((event) => event.type === "closed" && event.id === dialog.id)).toHaveLength(1);
+			}
+		});
+	}
+
+	it("abort and timeout invalidate IDs without letting old callbacks dismiss the next dialog", async () => {
+		vi.useFakeTimers();
+		for (const kind of ["select", "confirm", "input"] as const) {
+			for (const timeout of [false, true]) {
+				const controller = new AbortController();
+				const opts = { signal: controller.signal, timeout: 1000 };
+				const result =
+					kind === "select"
+						? ui.select("Pick", ["A"], opts)
+						: kind === "confirm"
+							? ui.confirm("Proceed", "Continue?", opts)
+							: ui.input("Name", "", opts);
+				const [dialog] = ui.getPendingDialogs();
+				if (timeout) await vi.advanceTimersByTimeAsync(1000);
+				else controller.abort();
+				await expect(result).resolves.toBe(kind === "confirm" ? false : undefined);
+				const next = ui.input("Next");
+				controller.abort();
+				await vi.advanceTimersByTimeAsync(2000);
+				expect(ui.resolveDialog(dialog.id, { kind: "cancel" })).toBe("stale");
+				const [pending] = ui.getPendingDialogs();
+				expect(pending.title).toBe("Next");
+				ui.resolveDialog(pending.id, { kind: "input", value: "next" });
+				await expect(next).resolves.toBe("next");
+			}
+		}
+		const signal = AbortSignal.abort();
+		await expect(ui.select("never", ["A"], { signal })).resolves.toBeUndefined();
+		await expect(ui.confirm("never", "", { signal })).resolves.toBe(false);
+		await expect(ui.input("never", "", { signal })).resolves.toBeUndefined();
+		expect(ui.getPendingDialogs()).toEqual([]);
+	});
+
+	it("rejects overlapping standard dialogs before they can replace the displayed dialog", async () => {
+		const first = ui.input("First");
+		for (const testCase of cases) await expect(testCase.open(ui)).rejects.toThrow("Extension dialog busy");
+		expect(host.editorContainer.render(80).join("\n")).toContain("First");
+		terminal.sendInput("\r");
+		await expect(first).resolves.toBe("");
+	});
+
+	it("late desktop callbacks and caller abort cannot close a newer dialog after remote settlement", async () => {
+		const controller = new AbortController();
+		const first = ui.select("First", ["A"], { signal: controller.signal });
+		const oldComponent = host.editorContainer.children[0];
+		const [dialog] = ui.getPendingDialogs();
+		ui.resolveDialog(dialog.id, { kind: "select", value: "A" });
+		const next = ui.input("Next");
+		oldComponent.handleInput?.("\r");
+		controller.abort();
+		expect(ui.getPendingDialogs()[0].title).toBe("Next");
+		expect(host.editorContainer.render(80).join("\n")).toContain("Next");
+		terminal.sendInput("\r");
+		await expect(first).resolves.toBe("A");
+		await expect(next).resolves.toBe("");
+	});
+
+	it("isolates listener failures, supports unsubscribe and reconnect snapshots", async () => {
+		ui.onDialog(() => {
+			throw new Error("offline");
+		});
+		ui.onDialog(async () => {
+			throw new Error("offline async");
+		});
+		const removed = vi.fn();
+		ui.onDialog(removed)();
+		const result = ui.editor("Edit");
+		const [dialog] = host.createExtensionUIContext().getPendingDialogs();
+		expect(Object.isFrozen(dialog)).toBe(true);
+		await Promise.resolve();
+		ui.resolveDialog(dialog.id, { kind: "editor", value: "" });
+		await expect(result).resolves.toBe("");
+		expect(removed).not.toHaveBeenCalled();
+	});
+
+	it("reset and stop cancel pending dialogs and remove session listeners", async () => {
+		for (const testCase of cases) {
+			const result = testCase.open(ui);
+			const [dialog] = ui.getPendingDialogs();
+			host.resetExtensionUI();
+			await expect(result).resolves.toBe(testCase.kind === "confirm" ? false : undefined);
+			expect(ui.resolveDialog(dialog.id, { kind: "cancel" })).toBe("stale");
+		}
+		const eventCount = events.length;
+		const listener = vi.fn();
+		ui.onDialog(listener);
+		const result = ui.input("Last");
+		mode.stop();
+		await expect(result).resolves.toBeUndefined();
+		expect(ui.getPendingDialogs()).toEqual([]);
+		expect(events).toHaveLength(eventCount);
+		expect(listener.mock.calls.map(([event]) => event.type)).toEqual(["opened", "closed"]);
+	});
+
+	it("does not expose project trust or custom dialogs", async () => {
+		const trust = host.createProjectTrustContext(harness.tempDir).ui.confirm("Trust?", "Sensitive cwd");
+		expect(ui.getPendingDialogs()).toEqual([]);
+		terminal.sendInput("\r");
+		await expect(trust).resolves.toBe(true);
+		const custom = ui.custom((_tui, _theme, _keys, done) => {
+			done("ok");
+			return new Text("Custom");
+		});
+		await expect(custom).resolves.toBe("ok");
+		expect(ui.getPendingDialogs()).toEqual([]);
+		expect(events).toEqual([]);
+	});
+
+	it("reports unavailable during Ctrl+G and accepts answers only after the external editor returns", async () => {
+		let finishExternal!: (result: ExternalEditorResult) => void;
+		externalEditor.mockImplementation(
+			() =>
+				new Promise((resolve) => {
+					finishExternal = resolve;
+				}),
+		);
+		const result = ui.editor("Edit", "prefill");
+		const [dialog] = ui.getPendingDialogs();
+		terminal.sendInput("\x07");
+		expect(ui.getPendingDialogs()[0]).toMatchObject({ id: dialog.id, unavailable: "external-editor" });
+		expect(ui.resolveDialog(dialog.id, { kind: "editor", value: "remote" })).toBe("invalid");
+		expect(ui.resolveDialog(dialog.id, { kind: "cancel" })).toBe("invalid");
+		finishExternal({ status: "complete", content: "external" });
+		await Promise.resolve();
+		expect(ui.getPendingDialogs()[0]).not.toHaveProperty("unavailable", "external-editor");
+		expect(ui.resolveDialog(dialog.id, { kind: "editor", value: "remote" })).toBe("accepted");
+		await expect(result).resolves.toBe("remote");
+		expect(events.filter((event) => event.type === "updated")).toHaveLength(2);
+	});
+
+	it("reset during external editing invalidates the ID and keeps new dialogs busy until child exit", async () => {
+		let finishExternal!: (result: ExternalEditorResult) => void;
+		externalEditor.mockImplementation(
+			() =>
+				new Promise((resolve) => {
+					finishExternal = resolve;
+				}),
+		);
+		const result = ui.editor("Edit", "prefill");
+		const [dialog] = ui.getPendingDialogs();
+		terminal.sendInput("\x07");
+		host.resetExtensionUI();
+		await expect(result).resolves.toBeUndefined();
+		expect(ui.resolveDialog(dialog.id, { kind: "cancel" })).toBe("stale");
+		await expect(ui.input("Too early")).rejects.toThrow("Extension dialog busy");
+		finishExternal({ status: "complete", content: "late external text" });
+		await Promise.resolve();
+		const next = ui.input("Next");
+		terminal.sendInput("\r");
+		await expect(next).resolves.toBe("");
+	});
+
+	it("late external editor completion cannot restart a stopped terminal", async () => {
+		let finishExternal!: (result: ExternalEditorResult) => void;
+		externalEditor.mockImplementation(
+			() =>
+				new Promise((resolve) => {
+					finishExternal = resolve;
+				}),
+		);
+		const result = ui.editor("Edit");
+		terminal.sendInput("\x07");
+		mode.stop();
+		await expect(result).resolves.toBeUndefined();
+		const start = vi.spyOn(host.ui, "start");
+		finishExternal({ status: "complete", content: "late" });
+		await Promise.resolve();
+		expect(start).not.toHaveBeenCalled();
+		await expect(ui.input("Stopped")).resolves.toBeUndefined();
+	});
+
+	it("returns empty/no-op/stale without interactive UI", () => {
+		harness.session.extensionRunner.setUIContext(undefined, "print");
